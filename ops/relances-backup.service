[Unit]
Description=Relances Architecte SQLite backup

[Service]
Type=oneshot
User=relances
Group=relances
WorkingDirectory=/home/relances/RelancesArchitecte
Environment=NODE_ENV=production
EnvironmentFile=/home/relances/RelancesArchitecte/.env
ExecStart=/usr/bin/npm run backup:db
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/relances/RelancesArchitecte
