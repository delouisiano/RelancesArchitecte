[Unit]
Description=Relances Architecte web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relances
Group=relances
WorkingDirectory=/home/relances/RelancesArchitecte
Environment=NODE_ENV=production
EnvironmentFile=/home/relances/RelancesArchitecte/.env
ExecStart=/home/relances/RelancesArchitecte/scripts/load-runtime-env.sh /usr/bin/npm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/relances/RelancesArchitecte

[Install]
WantedBy=multi-user.target
